{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "description": "AdGuard Home Docker image version",
      "customType": "regex",
      "managerFilePatterns": ["/^src/group_vars/all/stacks\\.yml$/"],
      "matchStrings": ["adguard_image_version:\\s*\"(?<currentValue>v[\\d.]+)\""],
      "datasourceTemplate": "docker",
      "depNameTemplate": "adguard/adguardhome"
    },
    {
      "description": "Tailscale Docker image version",
      "customType": "regex",
      "managerFilePatterns": ["/^src/group_vars/all/stacks\\.yml$/"],
      "matchStrings": ["tailscale_image_version:\\s*\"(?<currentValue>v[\\d.]+)\""],
      "datasourceTemplate": "docker",
      "depNameTemplate": "tailscale/tailscale"
    },
    {
      "description": "Duplicati Docker image version",
      "customType": "regex",
      "managerFilePatterns": ["/^src/group_vars/all/stacks\\.yml$/"],
      "matchStrings": ["duplicati_image_version:\\s*\"(?<currentValue>[\\d.]+)\""],
      "datasourceTemplate": "docker",
      "depNameTemplate": "lscr.io/linuxserver/duplicati"
    }
  ]
}
