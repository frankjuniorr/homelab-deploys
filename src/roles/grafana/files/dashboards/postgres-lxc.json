{
  "annotations": {"list": []},
  "description": "PostgreSQL (urano — 192.168.1.53) — postgres_exporter metrics + recursos do node LXC.",
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [

    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "title": "Status",
      "type": "row"
    },

    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "red", "value": null},
            {"color": "green", "value": 1}
          ]},
          "mappings": [
            {"options": {"0": {"color": "red", "index": 0, "text": "DOWN"}}, "type": "value"},
            {"options": {"1": {"color": "green", "index": 1, "text": "UP"}}, "type": "value"}
          ]
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1},
      "id": 1,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "auto", "orientation": "auto"},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "pg_up{job=\"postgres-lxc\"}",
        "legendFormat": "Status", "refId": "A"
      }],
      "title": "PostgreSQL",
      "type": "stat"
    },

    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"color": {"fixedColor": "orange", "mode": "fixed"}, "unit": "short", "decimals": 0,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 10},
            {"color": "red", "value": 50}
          ]}
        }
      },
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1},
      "id": 2,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "auto"},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "sum(pg_stat_activity_count{job=\"postgres-lxc\",state=\"active\"})",
        "legendFormat": "Active", "refId": "A"
      }],
      "title": "Active Connections",
      "type": "stat"
    },

    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"color": {"fixedColor": "blue", "mode": "fixed"}, "unit": "short", "decimals": 0}
      },
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 1},
      "id": 3,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "auto"},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "sum(pg_stat_activity_count{job=\"postgres-lxc\"})",
        "legendFormat": "Total", "refId": "A"
      }],
      "title": "Total Connections",
      "type": "stat"
    },

    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Taxa de acerto do buffer cache (shared_buffers). Valores abaixo de 90% indicam pressão de I/O.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "red", "value": null},
            {"color": "yellow", "value": 90},
            {"color": "green", "value": 99}
          ]},
          "unit": "percent", "min": 0, "max": 100
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1},
      "id": 4,
      "options": {"orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"]}, "showThresholdMarkers": true},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "sum(rate(pg_stat_database_blks_hit_total{job=\"postgres-lxc\",datname!~\"template.*\"}[$__rate_interval])) / (sum(rate(pg_stat_database_blks_hit_total{job=\"postgres-lxc\",datname!~\"template.*\"}[$__rate_interval])) + sum(rate(pg_stat_database_blks_read_total{job=\"postgres-lxc\",datname!~\"template.*\"}[$__rate_interval]))) * 100",
        "legendFormat": "Cache Hit %", "refId": "A"
      }],
      "title": "Cache Hit Ratio",
      "type": "gauge"
    },

    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"color": {"fixedColor": "green", "mode": "fixed"}, "unit": "dtdurations"}
      },
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1},
      "id": 5,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "auto"},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "time() - pg_postmaster_start_time_seconds{job=\"postgres-lxc\"}",
        "legendFormat": "Uptime", "refId": "A"
      }],
      "title": "PostgreSQL Uptime",
      "type": "stat"
    },

    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "id": 200,
      "title": "Databases & Transações",
      "type": "row"
    },

    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Tamanho de cada database (exceto templates).",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "bytes",
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 536870912},
            {"color": "red", "value": 2147483648}
          ]}
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 6},
      "id": 10,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "showUnfilled": true,
        "valueMode": "color"
      },
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "pg_database_size_bytes{job=\"postgres-lxc\",datname!~\"template.*\"}",
        "legendFormat": "{{datname}}", "refId": "A"
      }],
      "title": "Database Size",
      "type": "bargauge"
    },

    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 6},
      "id": 11,
      "options": {
        "legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(rate(pg_stat_database_xact_commit_total{job=\"postgres-lxc\",datname!~\"template.*\"}[$__rate_interval]))",
          "legendFormat": "Commits/s", "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(rate(pg_stat_database_xact_rollback_total{job=\"postgres-lxc\",datname!~\"template.*\"}[$__rate_interval]))",
          "legendFormat": "Rollbacks/s", "refId": "B"
        }
      ],
      "title": "Transactions / sec",
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14},
      "id": 201,
      "title": "Atividade",
      "type": "row"
    },

    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Tuples lidas (fetched = SELECT) e escritas (inserted/updated/deleted) por segundo.",
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15},
      "id": 20,
      "options": {
        "legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(rate(pg_stat_database_tup_fetched_total{job=\"postgres-lxc\"}[$__rate_interval]))",
          "legendFormat": "Fetched (SELECT)", "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(rate(pg_stat_database_tup_inserted_total{job=\"postgres-lxc\"}[$__rate_interval]))",
          "legendFormat": "Inserted", "refId": "B"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(rate(pg_stat_database_tup_updated_total{job=\"postgres-lxc\"}[$__rate_interval]))",
          "legendFormat": "Updated", "refId": "C"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(rate(pg_stat_database_tup_deleted_total{job=\"postgres-lxc\"}[$__rate_interval]))",
          "legendFormat": "Deleted", "refId": "D"
        }
      ],
      "title": "Tuples / sec",
      "type": "timeseries"
    },

    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Conexões agrupadas por estado. 'idle in transaction' por muito tempo pode indicar transações presas.",
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15},
      "id": 21,
      "options": {
        "legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "sum by(state) (pg_stat_activity_count{job=\"postgres-lxc\",state!=\"\"})",
        "legendFormat": "{{state}}", "refId": "A"
      }],
      "title": "Connections by State",
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 23},
      "id": 202,
      "title": "Cache & Locks",
      "type": "row"
    },

    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Cache hit ratio ao longo do tempo. Quedas abaixo de 90% indicam leituras indo ao disco — considere aumentar shared_buffers.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "red", "value": null},
            {"color": "yellow", "value": 90},
            {"color": "green", "value": 99}
          ]},
          "custom": {"thresholdsStyle": {"mode": "line"}}
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "id": 30,
      "options": {
        "legend": {"calcs": ["mean", "min"], "displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "sum by(datname) (rate(pg_stat_database_blks_hit_total{job=\"postgres-lxc\",datname!~\"template.*\"}[$__rate_interval])) / (sum by(datname) (rate(pg_stat_database_blks_hit_total{job=\"postgres-lxc\",datname!~\"template.*\"}[$__rate_interval])) + sum by(datname) (rate(pg_stat_database_blks_read_total{job=\"postgres-lxc\",datname!~\"template.*\"}[$__rate_interval]))) * 100",
        "legendFormat": "{{datname}}", "refId": "A"
      }],
      "title": "Cache Hit Ratio por Database (%)",
      "type": "timeseries"
    },

    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Locks por modo. Picos em ExclusiveLock ou AccessExclusiveLock podem indicar operações de DDL ou contenção.",
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "id": 31,
      "options": {
        "legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "sum by(mode) (pg_locks_count{job=\"postgres-lxc\",datname!~\"template.*\",mode!=\"\"})",
        "legendFormat": "{{mode}}", "refId": "A"
      }],
      "title": "Locks by Mode",
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 32},
      "id": 203,
      "title": "Recursos do Node (urano — LXC Postgres)",
      "description": "Métricas de sistema do container LXC urano coletadas via node_exporter (job: lxc-nodes).",
      "type": "row"
    },

    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "percentage", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 70},
            {"color": "red", "value": 90}
          ]},
          "unit": "percent", "min": 0, "max": 100
        },
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 4, "x": 0, "y": 33},
      "id": 40,
      "options": {"orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"]}, "showThresholdMarkers": true},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "(100 - (avg by(instance) (rate(node_cpu_seconds_total{job=\"lxc-nodes\",mode=\"idle\"}[$__rate_interval])) * 100)) * on(instance) group_left(nodename) node_uname_info{job=\"lxc-nodes\",nodename=\"urano\"}",
        "legendFormat": "CPU", "refId": "A"
      }],
      "title": "CPU Usage",
      "type": "gauge"
    },

    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "percentage", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 60},
            {"color": "red", "value": 80}
          ]},
          "unit": "percent", "min": 0, "max": 100
        },
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 4, "x": 4, "y": 33},
      "id": 41,
      "options": {"orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"]}, "showThresholdMarkers": true},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "((1 - node_memory_MemAvailable_bytes{job=\"lxc-nodes\"} / node_memory_MemTotal_bytes{job=\"lxc-nodes\"}) * 100) * on(instance) group_left(nodename) node_uname_info{job=\"lxc-nodes\",nodename=\"urano\"}",
        "legendFormat": "RAM Real", "refId": "A"
      }],
      "title": "RAM — Pressão Real",
      "type": "gauge"
    },

    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "percentage", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 70},
            {"color": "red", "value": 90}
          ]},
          "unit": "percent", "min": 0, "max": 100
        },
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 4, "x": 8, "y": 33},
      "id": 42,
      "options": {"orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"]}, "showThresholdMarkers": true},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "((node_filesystem_size_bytes{job=\"lxc-nodes\",mountpoint=\"/\",fstype!=\"tmpfs\"} - node_filesystem_free_bytes{job=\"lxc-nodes\",mountpoint=\"/\",fstype!=\"tmpfs\"}) / node_filesystem_size_bytes{job=\"lxc-nodes\",mountpoint=\"/\",fstype!=\"tmpfs\"} * 100) * on(instance) group_left(nodename) node_uname_info{job=\"lxc-nodes\",nodename=\"urano\"}",
        "legendFormat": "Disk /", "refId": "A"
      }],
      "title": "Disk Usage /",
      "type": "gauge"
    },

    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"color": {"fixedColor": "green", "mode": "fixed"}, "unit": "dtdurations"}
      },
      "gridPos": {"h": 3, "w": 6, "x": 12, "y": 33},
      "id": 43,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "auto"},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "(node_time_seconds{job=\"lxc-nodes\"} - node_boot_time_seconds{job=\"lxc-nodes\"}) * on(instance) group_left(nodename) node_uname_info{job=\"lxc-nodes\",nodename=\"urano\"}",
        "legendFormat": "Uptime", "refId": "A"
      }],
      "title": "Uptime",
      "type": "stat"
    },

    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"color": {"fixedColor": "blue", "mode": "fixed"}, "unit": "short", "decimals": 2}
      },
      "gridPos": {"h": 3, "w": 6, "x": 18, "y": 33},
      "id": 44,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "auto"},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "node_load1{job=\"lxc-nodes\"} * on(instance) group_left(nodename) node_uname_info{job=\"lxc-nodes\",nodename=\"urano\"}",
        "legendFormat": "Load 1m", "refId": "A"
      }],
      "title": "Load Average 1m",
      "type": "stat"
    },

    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"color": {"fixedColor": "blue", "mode": "fixed"}, "unit": "bytes"}
      },
      "gridPos": {"h": 3, "w": 6, "x": 12, "y": 36},
      "id": 45,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "auto"},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "node_memory_MemAvailable_bytes{job=\"lxc-nodes\"} * on(instance) group_left(nodename) node_uname_info{job=\"lxc-nodes\",nodename=\"urano\"}",
        "legendFormat": "RAM Disponível", "refId": "A"
      }],
      "title": "RAM Disponível",
      "type": "stat"
    },

    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"color": {"fixedColor": "blue", "mode": "fixed"}, "unit": "short", "decimals": 2}
      },
      "gridPos": {"h": 3, "w": 6, "x": 18, "y": 36},
      "id": 46,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "auto"},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "node_load5{job=\"lxc-nodes\"} * on(instance) group_left(nodename) node_uname_info{job=\"lxc-nodes\",nodename=\"urano\"}",
        "legendFormat": "Load 5m", "refId": "A"
      }],
      "title": "Load Average 5m",
      "type": "stat"
    },

    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 39},
      "id": 50,
      "options": {
        "legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "avg by(instance) (rate(node_cpu_seconds_total{job=\"lxc-nodes\",mode!=\"idle\"}[$__rate_interval])) * on(instance) group_left(nodename) node_uname_info{job=\"lxc-nodes\",nodename=\"urano\"}",
          "legendFormat": "CPU Total", "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "avg by(instance) (rate(node_cpu_seconds_total{job=\"lxc-nodes\",mode=\"system\"}[$__rate_interval])) * on(instance) group_left(nodename) node_uname_info{job=\"lxc-nodes\",nodename=\"urano\"}",
          "legendFormat": "System", "refId": "B"
        }
      ],
      "title": "CPU Usage over time (urano)",
      "type": "timeseries"
    },

    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80,
            "stacking": {"group": "A", "mode": "normal"},
            "showPoints": "never"
          },
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Apps"},
            "properties": [{"id": "color", "value": {"fixedColor": "dark-orange", "mode": "fixed"}}]
          },
          {
            "matcher": {"id": "byName", "options": "Cache + Buffers"},
            "properties": [{"id": "color", "value": {"fixedColor": "dark-green", "mode": "fixed"}}]
          },
          {
            "matcher": {"id": "byName", "options": "Livre"},
            "properties": [{"id": "color", "value": {"fixedColor": "dark-blue", "mode": "fixed"}}]
          }
        ]
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 39},
      "id": 51,
      "options": {
        "legend": {"calcs": ["mean", "lastNotNull"], "displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "(node_memory_MemTotal_bytes{job=\"lxc-nodes\"} - node_memory_MemFree_bytes{job=\"lxc-nodes\"} - node_memory_Buffers_bytes{job=\"lxc-nodes\"} - node_memory_Cached_bytes{job=\"lxc-nodes\"} - node_memory_SReclaimable_bytes{job=\"lxc-nodes\"}) * on(instance) group_left(nodename) node_uname_info{job=\"lxc-nodes\",nodename=\"urano\"}",
          "legendFormat": "Apps", "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "(node_memory_Buffers_bytes{job=\"lxc-nodes\"} + node_memory_Cached_bytes{job=\"lxc-nodes\"} + node_memory_SReclaimable_bytes{job=\"lxc-nodes\"}) * on(instance) group_left(nodename) node_uname_info{job=\"lxc-nodes\",nodename=\"urano\"}",
          "legendFormat": "Cache + Buffers", "refId": "B"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "node_memory_MemFree_bytes{job=\"lxc-nodes\"} * on(instance) group_left(nodename) node_uname_info{job=\"lxc-nodes\",nodename=\"urano\"}",
          "legendFormat": "Livre", "refId": "C"
        }
      ],
